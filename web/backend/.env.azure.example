# Azure deployment secrets — copy to .env.azure and fill in values
# .env.azure is gitignored; never commit real secrets.

# Neon (or any Postgres) connection string
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require&channel_binding=require"

# Strong random secret for JWT signing — generate with:
#   openssl rand -hex 32
JWT_SECRET="change_me_to_a_strong_random_secret"
