# ==========================================
# EcoCode Backend Environment Variables
# Location: web/backend/.env
# ==========================================

# 1. JWT Secret (REQUIRED for production)
JWT_SECRET=your_super_secret_jwt_key_here

# 2. PostgreSQL database URL (REQUIRED)
DATABASE_URL=postgres://user:pass@localhost/ecocode

# 3. Set to true in production to enable Secure cookies and tighter CORS
PRODUCTION=false

# 4. Allowed CORS origin for the frontend
CORS_ORIGIN=http://localhost:3000
