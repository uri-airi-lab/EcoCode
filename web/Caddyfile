# Caddy reverse proxy config for EcoCode
# Place this at /etc/caddy/Caddyfile on your homelab host.
#
# ─── OPTION A: No domain — plain HTTP on your public IP ──────────────────────
# Users access via http://71.117.140.233  (port 80, no HTTPS)
# Make sure port 80 is forwarded on your router to this machine.

:80 {
    # All /api/* traffic → Rust Axum backend
    reverse_proxy /api/* localhost:3001

    # Everything else → Next.js frontend
    reverse_proxy /* localhost:3000

    encode gzip
}

# ─── OPTION B: Free DuckDNS subdomain (HTTPS, upgrade later) ─────────────────
# 1. Sign up at https://duckdns.org and claim e.g. "ecocode.duckdns.org"
# 2. Point it to your public IP: 71.117.140.233
# 3. Replace the :80 block above with this block, then: sudo systemctl reload caddy
#
# ecocode.duckdns.org {
#     reverse_proxy /api/* localhost:3001
#     reverse_proxy /* localhost:3000
#     encode gzip
# }

